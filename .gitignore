# The rule: anything re-downloadable or rebuildable stays out.

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local settings: holds your PIN and your domain
.env

# Runtime state: PID, tunnel URL, PIN, log. Recreated on every start.
.run/

# Caches
.pytest_cache
.ruff_cache
.DS_Store
