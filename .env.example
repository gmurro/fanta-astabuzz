# Copy to .env and edit. Anything here can still be overridden on the command
# line. .env is gitignored, because the PIN lives in it.

# Fixed PIN instead of a new random one each run. Exactly 4 digits.
# ASTABUZZ_PIN=1998

# Publish on your own Cloudflare hostname rather than a throwaway link.
# Needs `cloudflared tunnel login` once. See the README before enabling it:
# a fixed hostname is guessable where a throwaway one is not.
# ASTABUZZ_DOMAIN=astabuzz.example.com

# How many buttons your lega has, 1 to 12.
# ASTABUZZ_BUTTONS=8

# ASTABUZZ_PORT=8787
